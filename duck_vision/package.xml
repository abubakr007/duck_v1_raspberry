<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duck_vision</name>
  <version>0.0.0</version>
  <description>libcamera-based camera driver for the Duck robot (Raspberry Pi Camera Module 3 Wide / IMX708 on Pi 5).</description>
  <maintainer email="abubakr18abdalla@gmail.com">abubakr</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>camera_info_manager</depend>

  <!-- libcamera comes from the Raspberry Pi apt source (libcamera0.5 / libcamera-dev 0.5.2)
       and has no rosdep key on Ubuntu Noble. CMake locates it via pkg-config (`libcamera`).
       See ../camera.md for the install steps. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
